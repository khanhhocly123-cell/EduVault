# Copy file này thành .env rồi điền key vào. KHÔNG commit .env.
#
# Chỉ cần MỘT key là chạy được. Điền hai nhà khác nhau mới đối chiếu chéo
# thật được (bước 2 phải khác nhà, cùng nhà thì nó chỉ gật đầu với chính nó).

# ── Rẻ nhất để bắt đầu ────────────────────────────────────────────────────
# Google AI Studio: aistudio.google.com/apikey — CÓ HẠN MỨC MIỄN PHÍ, lấy key
# trong 30 giây, không cần thẻ. Đủ để thử và chạy eval.
# Model: gemini-3.5-flash-lite | gemini-3.5-flash | gemini-3.6-flash
GEMINI_API_KEY=AQ....

# ── Cổng gộp, trả bằng ví VNĐ (không cần thẻ quốc tế) ─────────────────────
# api.stali.vn — một key gọi được cả Claude, GPT, Gemini, DeepSeek.
# Nạp ví bằng VietQR. Key có dạng sk-stali-...
# Model: claude-sonnet-5 | claude-opus-5 | gpt-5.6-sol | claude-fable-5
# Muốn ép đi qua Stali thay vì gọi thẳng nhà gốc: --model stali:claude-sonnet-5
STALI_API_KEY=sk-stali-...

# ── Gọi thẳng nhà gốc (cần thẻ quốc tế) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Tuỳ chọn: đổi model mặc định khi benchmark
# DE_MODEL=gemini-3.5-flash
# DE_VERIFY_MODEL=gemini-3.1-pro-preview
